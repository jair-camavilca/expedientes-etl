# Datos judiciales y resultados locales: nunca subir al repositorio.
entrada/*
!entrada/.gitkeep
salida/*
!salida/.gitkeep
control_calidad/*
!control_calidad/.gitkeep
archivo/*
trabajos/*
informes/*
!informes/.gitkeep
tmp/
*.pdf
*.docx

# Entorno y archivos generados por Python/Windows.
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
*.log
Thumbs.db
Desktop.ini
README_DESARROLLO.md
MEMORY.md
